{
    "name": "teleprompter",
    "version": "1.4.0",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "icons": "electron tools/make-icons.js",
        "build:win": "electron-builder --win portable",
        "build:mac": "electron-builder --mac",
        "build": "electron-builder --win portable --mac"
    },
    "build": {
        "appId": "com.platypustools.teleprompter",
        "productName": "Teleprompter",
        "files": [
            "main.js",
            "index.html",
            "app.js",
            "style.css",
            "manifest.json",
            "favicon.svg",
            "icon.ico",
            "icon-192.png",
            "icon-512.png"
        ],
        "win": {
            "target": "portable",
            "icon": "icon.ico",
            "signAndEditExecutable": false
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "icon": "build/icon.png",
            "category": "public.app-category.productivity",
            "darkModeSupport": true
        },
        "portable": {
            "artifactName": "Teleprompter.exe"
        },
        "dmg": {
            "artifactName": "Teleprompter.dmg"
        }
    },
    "devDependencies": {
        "electron": "^35.0.0",
        "electron-builder": "^26.0.0",
        "playwright-core": "^1.62.1"
    }
}
